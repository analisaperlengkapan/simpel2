# Multi-stage Dockerfile for SIMPelv2 Backend Services (Workspace Members)
# This template can be used for all backend services in layanan/shared/*
# 
# Usage: Build from workspace root with:
#   podman build -t image:tag -f layanan/shared/SERVICE_NAME/Dockerfile .
#
# Replace SERVICE_NAME with: ai, bantuan, dasbor, dokumen, integrasi, konfigurasi, laporan, notifikasi

FROM rust:1.90-slim AS chef
RUN cargo install cargo-chef --locked
WORKDIR /workspace

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /workspace/recipe.json recipe.json

# Cook dependencies (this layer is cached)
RUN cargo chef cook --release --recipe-path recipe.json

# Copy source code
COPY . .

# Build the specific service
# NOTE: Replace SERVICE_NAME with actual service name (e.g., layanan-ai)
ARG SERVICE_NAME
RUN cargo build --release --bin ${SERVICE_NAME}

# Runtime stage
FROM debian:bookworm-slim

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y ca-certificates libssl3 libpq5 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
ARG SERVICE_NAME
COPY --from=builder /workspace/target/release/${SERVICE_NAME} /app/service

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Expose default port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["/app/service", "health"] || exit 1

# Run the service
CMD ["/app/service"]
