# ========================================
# SIMPelv2 - Layanan Integrasi
# Environment Configuration Example
# ========================================

# ========================================
# Database Configuration
# ========================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perlengkapan
DATABASE_POOL_SIZE=10

# ========================================
# Server Configuration
# ========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=info
# Options: trace, debug, info, warn, error
RUST_LOG=info

# ========================================
# Storage Configuration
# ========================================
# Storage strategy: "database" or "file"
STORAGE_TYPE=database
# Output directory for file exports (if STORAGE_TYPE=file)
OUTPUT_DIR=./output

# ========================================
# MonSAKTI Configuration
# ========================================
# MonSAKTI API Base URL
MONSAKTI_BASE_URL=https://monsakti.kemenkeu.go.id/sitp-monsakti-omspan/webservice

# MonSAKTI Module Tokens
# Get these from MonSAKTI dashboard for each module
MONSAKTI_TOKEN_ADM=your_adm_token_here
MONSAKTI_TOKEN_ANG=your_ang_token_here
MONSAKTI_TOKEN_AST=your_ast_token_here
MONSAKTI_TOKEN_BEN=your_ben_token_here
MONSAKTI_TOKEN_GLP=your_glp_token_here
MONSAKTI_TOKEN_KOM=your_kom_token_here
MONSAKTI_TOKEN_PEM=your_pem_token_here
MONSAKTI_TOKEN_PER=your_per_token_here

# ========================================
# MySIMKARI Configuration
# ========================================
# MySIMKARI API Base URL
MYSIMKARI_BASE_URL=https://mysimkari.kejaksaan.go.id/api/anbut
# MySIMKARI Authentication Token
MYSIMKARI_TOKEN=your_mysimkari_token_here

# ========================================
# SIMAN v2.0 Configuration
# ========================================
# SIMAN OAuth2 Credentials
SIMAN_CLIENT_ID=your_siman_client_id
SIMAN_CLIENT_SECRET=your_siman_client_secret

# SIMAN OAuth2 Token Endpoint
SIMAN_TOKEN_URL=https://sso.kemenkeu.go.id/connect/token

# SIMAN BA Key (Unit Key / Balai Key)
SIMAN_BA_KEY=your_ba_key_here

# SIMAN API Base URL
SIMAN_BASE_URL=https://apigateway.kemenkeu.go.id

# SIMAN Concurrency Limit (parallel requests)
# Recommended: 5-10 to avoid rate limiting
SIMAN_CONCURRENCY_LIMIT=5

# ========================================
# Testing Configuration (Optional)
# ========================================
# Test with specific satker code for development
# TEST_SATKER=123456

# ========================================
# SCHEDULER CONFIGURATION
# ========================================
# Menggunakan cron expression format untuk fleksibilitas
# Format: "second minute hour day-of-month month day-of-week year"
# Contoh: "0 2 * * *" = setiap hari jam 02:00
#         "0 3 * * 0" = setiap hari Minggu jam 03:00
#         "0 0 */6 * *" = setiap 6 jam
#         "0 0 12 * * MON-FRI" = setiap hari kerja jam 12:00

# Enable/disable scheduler (true/false)
# NOTE: Disabled by default - use Kubernetes CronJob for scheduling in production
SCHEDULER_ENABLED=false

# MonSAKTI - Jadwal penarikan data (default: setiap hari jam 02:00 WIB)
MONSAKTI_SCHEDULE=0 2 * * *

# MySIMKARI - Jadwal penarikan data (default: setiap hari jam 02:00 WIB)
MYSIMKARI_SCHEDULE=0 2 * * *

# SIMAN - Jadwal penarikan data (default: setiap hari Minggu jam 03:00 WIB)
SIMAN_SCHEDULE=0 3 * * 0

# Timezone untuk scheduler (default: Asia/Jakarta)
SCHEDULER_TIMEZONE=Asia/Jakarta
