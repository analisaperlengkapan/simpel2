# ========================================
# Layanan Pembinaan Perlengkapan
# Environment Configuration Example
# ========================================

# ========================================
# Server Configuration
# ========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8093
# CORS Configuration (comma-separated or *)
CORS_ALLOWED_ORIGINS=*

# ========================================
# Database Configuration
# ========================================
# Note: Use a dedicated database 'perlengkapan_db'.
# The 'integrasi' service schema will also be merged into this database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/perlengkapan_db

# ========================================
# Service Integration
# ========================================
# Secreton (Secret Manager)
SECRETON_URL=http://localhost:8200

# Authenc (IAM)
AUTHENC_URL=http://localhost:8088

# ========================================
# Logging
# ========================================
# Options: trace, debug, info, warn, error
RUST_LOG=info,layanan_perlengkapan=debug
