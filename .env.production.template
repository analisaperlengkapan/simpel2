# SIMPEL .env production — TEMPLATE (no real values).
#
# File ini DOKUMENTASI saja: berisi daftar key yang dipakai di production,
# beserta lokasi sebenarnya nilai tsb di Secreton.
#
# NEVER copy file ini ke .env dengan nilai real lalu commit.
# Production secret = Secreton kv/<service>/...

# ─── Image registry ────────────────────────────────────────────────
# Tag: SemVer immutable, push via release.yml workflow saat git tag v*.*.*
SIMPEL_IMAGE_REGISTRY=ghcr.io/analisaperlengkapan/simpel2
SIMPEL_IMAGE_TAG=v0.1.0

# ─── ghcr.io pull (Helm Secret di namespace) ───────────────────────
GHCR_USERNAME=<github-handle>
GHCR_TOKEN=<PAT-with-read:packages>     # → ghcr-pull k8s Secret di simpelv2-production

# ─── DigiCert TLS (k8s Secret di istio-system) ─────────────────────
# kubectl -n istio-system create secret tls simpel-tls --cert=... --key=...
DIGICERT_FULLCHAIN_PEM=/path/to/digicert-fullchain.pem
DIGICERT_PRIVATE_KEY_PEM=/path/to/private-key.pem

# ─── Secreton bootstrap (one-shot, OFFLINE secrets) ────────────────
# WAJIB simpan offline (password manager / brankas), bukan di file ini.
# SECRETON_UNSEAL_KEYS (5 keys, Shamir 3-of-5)
# SECRETON_ROOT_TOKEN (revoke setelah bootstrap selesai)

# ─── Database (di-fetch service via Secreton Kubernetes Auth) ──────
# DATABASE_URL  → Secreton kv/postgres/{authenc,perlengkapan,integrasi,secreton,simpelv2}
# DB_USERNAME   → Secreton kv/postgres/<db>/username
# DB_PASSWORD   → Secreton kv/postgres/<db>/password

# ─── Authenc service (di-fetch authenc via Secreton) ───────────────
# JWT_SECRET                 → Secreton kv/authenc/jwt
# ED25519_PRIVATE_KEY        → Secreton kv/authenc/signing-keys/ed25519
# ECDSA_P256_PRIVATE_KEY     → Secreton kv/authenc/signing-keys/ecdsa-p256
# ENCRYPTION_KEY             → Secreton kv/authenc/encryption
# SMTP_PASSWORD              → Secreton kv/authenc/smtp/password
# OAUTH2_*_CLIENT_SECRET     → Secreton kv/authenc/oauth2/<provider>/client-secret

# ─── Integrasi tokens (di-fetch layanan-integrasi via Secreton) ────
# CronJob production AKTIF: SIMAN Minggu 04:00 WIB, MySIMKARI/MonSAKTI tiap 6 jam.
# SIMAN_CLIENT_ID            → Secreton kv/integrasi/tokens/siman/client-id
# SIMAN_CLIENT_SECRET        → Secreton kv/integrasi/tokens/siman/client-secret
# MYSIMKARI_TOKEN            → Secreton kv/integrasi/tokens/mysimkari/token
# MONSAKTI_BEARER            → Secreton kv/integrasi/tokens/monsakti/bearer

# ─── simpelv1 Laravel (di-fetch via init container fetch-secrets) ──
# APP_KEY                    → Secreton kv/simpelv1/app/app_key
# SIMPELV1_DB_USERNAME       → Secreton kv/postgres/simpelv2/username
# SIMPELV1_DB_PASSWORD       → Secreton kv/postgres/simpelv2/password

# ─── Public URLs (NOT secret, di-render config.json runtime) ───────
PORTAL_URL=https://simpel.kejaksaan.go.id/portal
AUTHENC_URL=https://simpel.kejaksaan.go.id/api/v1/auth
API_URL=https://simpel.kejaksaan.go.id/api/perlengkapan

# ─── Helm values override ──────────────────────────────────────────
# Lihat infra/helm/simpel/values-production.yaml untuk override production-specific.
HELM_NAMESPACE=simpelv2-production
HELM_RELEASE_NAME=simpel
