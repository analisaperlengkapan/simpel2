# CAPTCHA System Development Environment Variables

# Database Configuration
CAPTCHA_DB_HOST=localhost
CAPTCHA_DB_PORT=5433
CAPTCHA_DB_NAME=captcha_analytics_dev
CAPTCHA_DB_USER=captcha_dev
CAPTCHA_DB_PASSWORD=dev_password_123

# Redis Configuration
CAPTCHA_REDIS_HOST=localhost
CAPTCHA_REDIS_PORT=6380
CAPTCHA_REDIS_PASSWORD=dev_redis_123

# Authenc Integration
AUTHENC_API_URL=http://localhost:8088
AUTHENC_REALM=simpel
AUTHENC_CLIENT_ID=portal
AUTHENC_CLIENT_SECRET=dev_client_secret

# Secreton Integration
SECRETON_API_URL=http://localhost:8200
SECRETON_TOKEN=dev_token_123
SECRETON_MOUNT_PATH=captcha
SECRETON_NAMESPACE=development

# Monitoring Configuration
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=dev_grafana_key
CAPTCHA_GRAFANA_PASSWORD=dev_grafana_123

# Elasticsearch Configuration
ELASTICSEARCH_ENDPOINT=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=dev_elastic_123

# OTLP Tracing
OTLP_ENDPOINT=http://localhost:14268/api/traces
JAEGER_AGENT_ENDPOINT=localhost:6831
JAEGER_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces

# Email Alerting (disabled in development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev@localhost
SMTP_PASSWORD=dev_smtp

# Slack Integration (disabled in development)
SLACK_WEBHOOK_URL=http://localhost:3000/mock/slack

# Webhook Alerting
ALERT_WEBHOOK_URL=http://localhost:3000/mock/alerts
BACKUP_NOTIFICATION_WEBHOOK=http://localhost:3000/mock/backup

# Security Configuration
CAPTCHA_ENCRYPTION_KEY=dev_encryption_key_32_characters_
CAPTCHA_SIGNING_KEY=dev_signing_key_here
CAPTCHA_JWT_SECRET=dev_jwt_secret_here

# Performance Configuration (relaxed for development)
CAPTCHA_MAX_CONCURRENT_CHALLENGES=100
CAPTCHA_CACHE_TTL=1800
CAPTCHA_REQUEST_TIMEOUT=10000

# Backup Configuration
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=dev-captcha-backups
BACKUP_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=dev_access_key
AWS_SECRET_ACCESS_KEY=dev_secret_key

# Feature Flags
CAPTCHA_BEHAVIORAL_ANALYSIS_ENABLED=true
CAPTCHA_ACCESSIBILITY_ENABLED=true
CAPTCHA_ADVANCED_ANALYTICS_ENABLED=true
CAPTCHA_REAL_TIME_MONITORING_ENABLED=true

# Rate Limiting (relaxed for development)
CAPTCHA_RATE_LIMIT_REQUESTS_PER_MINUTE=120
CAPTCHA_RATE_LIMIT_BURST=20
CAPTCHA_RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_OUTPUT=stdout

# Development/Debug
CAPTCHA_DEBUG_MODE=true
CAPTCHA_MOCK_MODE=false
CAPTCHA_TEST_MODE=false
