{
    "dashboard": {
        "title": "SIMPEL - Integration Health",
        "tags": [
            "simpelv2",
            "integration",
            "sync"
        ],
        "timezone": "Asia/Jakarta",
        "schemaVersion": 38,
        "version": 1,
        "refresh": "1m",
        "panels": [
            {
                "id": 1,
                "title": "Integration Sync Rate",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "sum(rate(integration_syncs_total[5m])) by (service, status)",
                        "legendFormat": "{{service}} - {{status}}",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "ops",
                        "label": "Syncs/sec"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 2,
                "title": "Integration Success Rate",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "sum(rate(integration_syncs_total{status=\"success\"}[30m])) / sum(rate(integration_syncs_total[30m]))",
                        "refId": "A"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "textMode": "value"
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 0.80,
                                    "color": "yellow"
                                },
                                {
                                    "value": 0.95,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 3,
                "title": "Integration Sync Duration (p95)",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "histogram_quantile(0.95, sum(rate(integration_sync_duration_seconds_bucket[30m])) by (le, service, sync_type))",
                        "legendFormat": "{{service}} - {{sync_type}}",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "s",
                        "label": "Duration"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 4,
                "title": "Records Synced Rate",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "sum(rate(integration_records_synced_total[5m])) by (service, record_type)",
                        "legendFormat": "{{service}} - {{record_type}}",
                        "refId": "A"
                    }
                ],
                "yaxes": [
                    {
                        "format": "ops",
                        "label": "Records/sec"
                    },
                    {
                        "format": "short"
                    }
                ]
            },
            {
                "id": 5,
                "title": "Integration Failures (Last 24h)",
                "type": "table",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 16
                },
                "targets": [
                    {
                        "expr": "sum(increase(integration_syncs_total{status=\"failed\"}[24h])) by (service, sync_type)",
                        "format": "table",
                        "instant": true,
                        "refId": "A"
                    }
                ],
                "transformations": [
                    {
                        "id": "organize",
                        "options": {
                            "excludeByName": {
                                "Time": true
                            },
                            "indexByName": {},
                            "renameByName": {
                                "service": "Service",
                                "sync_type": "Sync Type",
                                "Value": "Failures"
                            }
                        }
                    }
                ]
            },
            {
                "id": 6,
                "title": "Sync Duration by Service",
                "type": "heatmap",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 16
                },
                "targets": [
                    {
                        "expr": "sum(rate(integration_sync_duration_seconds_bucket[5m])) by (le, service)",
                        "format": "heatmap",
                        "refId": "A"
                    }
                ],
                "options": {
                    "calculate": false,
                    "cellGap": 2,
                    "color": {
                        "exponent": 0.5,
                        "fill": "dark-orange",
                        "mode": "scheme",
                        "reverse": false,
                        "scale": "exponential",
                        "scheme": "Spectral",
                        "steps": 128
                    },
                    "exemplars": {
                        "color": "rgba(255,0,255,0.7)"
                    },
                    "filterValues": {
                        "le": 1e-9
                    },
                    "legend": {
                        "show": true
                    },
                    "rowsFrame": {
                        "layout": "auto"
                    },
                    "tooltip": {
                        "show": true,
                        "yHistogram": false
                    },
                    "yAxis": {
                        "axisPlacement": "left",
                        "reverse": false,
                        "unit": "s"
                    }
                }
            },
            {
                "id": 7,
                "title": "Total Records Synced (Last 24h)",
                "type": "stat",
                "gridPos": {
                    "h": 4,
                    "w": 6,
                    "x": 0,
                    "y": 24
                },
                "targets": [
                    {
                        "expr": "sum(increase(integration_records_synced_total[24h]))",
                        "refId": "A"
                    }
                ],
                "options": {
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "textMode": "value"
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "short",
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 1000,
                                    "color": "yellow"
                                },
                                {
                                    "value": 10000,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            },
            {
                "id": 8,
                "title": "Sync Success Rate by Service",
                "type": "bargauge",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 6,
                    "y": 24
                },
                "targets": [
                    {
                        "expr": "sum(rate(integration_syncs_total{status=\"success\"}[30m])) by (service) / sum(rate(integration_syncs_total[30m])) by (service)",
                        "legendFormat": "{{service}}",
                        "refId": "A"
                    }
                ],
                "options": {
                    "displayMode": "gradient",
                    "orientation": "horizontal",
                    "reduceOptions": {
                        "values": false,
                        "calcs": [
                            "lastNotNull"
                        ]
                    },
                    "showUnfilled": true
                },
                "fieldConfig": {
                    "defaults": {
                        "unit": "percentunit",
                        "min": 0,
                        "max": 1,
                        "thresholds": {
                            "mode": "absolute",
                            "steps": [
                                {
                                    "value": 0,
                                    "color": "red"
                                },
                                {
                                    "value": 0.80,
                                    "color": "yellow"
                                },
                                {
                                    "value": 0.95,
                                    "color": "green"
                                }
                            ]
                        }
                    }
                }
            }
        ]
    }
}
