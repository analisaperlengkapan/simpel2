# Secreton Bootstrap Configuration
# =================================
# This file contains ONLY infrastructure configuration needed to start Secreton.
# NO SECRETS should ever be placed in this file.
# All other configuration (auth, database, MFA, etc.) is stored encrypted in the storage backend.
#
# This follows HashiCorp Vault's security model:
# 1. Minimal bootstrap config (this file)
# 2. All sensitive config encrypted in storage
# 3. Vault starts SEALED
# 4. Operators unseal with secret shares
# 5. Application config loaded from encrypted storage

# =================================
# Storage Backend (REQUIRED)
# =================================
# Choose ONE storage backend. This determines where Secreton stores its encrypted data.

[storage]
# Backend type: "raft" (recommended), "file", "postgres", "memory" (dev only)
backend = "raft"

# Raft Integrated Storage (RECOMMENDED for production HA)
# Provides built-in consensus and high availability without external dependencies
[storage.raft]
path = "/var/lib/secreton/raft"
node_id = "node1"
# listener_addr = "0.0.0.0:6000"

# Cluster configuration (for multi-node)
# Uncomment and configure for HA cluster:
# [[storage.raft.retry_join]]
# leader_api_addr = "https://secreton-node2:8200"
# leader_ca_cert_file = "/etc/secreton/tls/ca.pem"
#
# [[storage.raft.retry_join]]
# leader_api_addr = "https://secreton-node3:8200"
# leader_ca_cert_file = "/etc/secreton/tls/ca.pem"

# Performance tuning (optional)
[storage.raft.performance]
election_timeout_ms = 1000
heartbeat_interval_ms = 300
snapshot_interval_secs = 120
max_appending_entries = 64

# File Backend (for development/single-node)
# [storage.file]
# path = "/var/lib/secreton/data"
# sync_writes = true

# PostgreSQL Backend (legacy, not recommended)
# Connection URL from environment variable SECRETON_STORAGE_URL only
# [storage.postgres]
# # No credentials here! Use SECRETON_STORAGE_URL env var
# # Example: SECRETON_STORAGE_URL=postgres://user:pass@host:5432/secreton_db
# max_connections = 50

# =================================
# API Listener (REQUIRED)
# =================================
[listener.http]
address = "0.0.0.0:8200"
tls_enabled = false  # Set to true in production

# TLS Configuration (REQUIRED for production)
# Uncomment for production:
# [listener.http.tls]
# cert_file = "/etc/secreton/tls/cert.pem"
# key_file = "/etc/secreton/tls/key.pem"
# min_version = "1.3"
# cipher_suites = [
#     "TLS_AES_256_GCM_SHA384",
#     "TLS_CHACHA20_POLY1305_SHA256",
#     "TLS_AES_128_GCM_SHA256"
# ]

# =================================
# gRPC Listener (OPTIONAL)
# =================================
[listener.grpc]
enabled = true
address = "0.0.0.0:8201"

# =================================
# Seal Configuration (REQUIRED)
# =================================
# Determines how the master encryption key is protected

[seal]
type = "shamir"  # Options: "shamir", "aws-kms", "gcp-kms", "azure-kv"

# Shamir Secret Sharing (default, recommended for on-premise)
[seal.shamir]
shares = 5      # Number of key shares to generate
threshold = 3   # Number of shares required to unseal

# AWS KMS Auto-Unseal (optional, for AWS deployments)
# Requires AWS credentials via environment or IAM role
# [seal.aws_kms]
# region = "us-east-1"
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/..."
# # Credentials from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY env vars

# GCP KMS Auto-Unseal (optional, for GCP deployments)
# Requires GCP credentials via environment or service account
# [seal.gcp_kms]
# project = "my-gcp-project"
# region = "global"
# key_ring = "secreton-keyring"
# crypto_key = "secreton-seal-key"
# # Credentials from GOOGLE_APPLICATION_CREDENTIALS env var

# Azure Key Vault Auto-Unseal (optional, for Azure deployments)
# Requires Azure credentials via environment or managed identity
# [seal.azure_kv]
# vault_name = "secreton-keyvault"
# key_name = "secreton-seal-key"
# # Credentials from AZURE_* env vars

# =================================
# Telemetry (OPTIONAL)
# =================================
[telemetry]
prometheus_enabled = true
metrics_path = "/metrics"
# Disable hostname in metrics for privacy
disable_hostname = false

# =================================
# Logging (OPTIONAL - Bootstrap Only)
# =================================
# Note: Full logging config is stored in encrypted storage
log_level = "info"     # Options: "trace", "debug", "info", "warn", "error"
log_format = "json"    # Options: "json", "pretty"

# =================================
# NOTES
# =================================
# 1. This file should be committed to version control (no secrets!)
# 2. Actual application config (auth, database, MFA) stored encrypted
# 3. Use environment variables for any dynamic values:
#    - SECRETON_STORAGE_URL (for database connection)
#    - AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY (for AWS KMS)
#    - GOOGLE_APPLICATION_CREDENTIALS (for GCP KMS)
#    - AZURE_* variables (for Azure Key Vault)
# 4. See secreton.toml.example for more detailed configuration options
