{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SIMPEL umbrella chart values",
  "description": "Validasi nilai values.yaml. Field kritis seperti image tag wajib semver immutable.",
  "type": "object",
  "required": [
    "global",
    "namespace"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "registry",
        "imageTag",
        "environment"
      ],
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1,
          "description": "Image registry, contoh: ghcr.io/analisaperlengkapan/simpel2"
        },
        "imageTag": {
          "type": "string",
          "pattern": "^v\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$",
          "description": "WAJIB semver immutable (v0.1.0, v1.2.3-rc1). DILARANG: latest, stag, prod, kosong."
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent"
          ],
          "description": "`Never` sengaja TIDAK diizinkan: dikombinasikan dengan tag yang bisa bergerak ia membuat pod tak bisa dipulihkan begitu image-nya hilang dari disk node — persis kondisi namespace simpelv2-production hari ini."
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string",
          "enum": [
            "staging",
            "production"
          ]
        },
        "domain": {
          "type": "string"
        },
        "istioNamespace": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "priorityClassName": {
          "type": "string"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        }
      }
    },
    "namespace": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "istioInjection": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "podSecurityEnforce": {
          "type": "string"
        },
        "podSecurityAudit": {
          "type": "string"
        },
        "podSecurityWarn": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "mtls": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "DISABLE",
            "PERMISSIVE",
            "STRICT",
            "UNSET"
          ]
        }
      }
    },
    "secretonAuth": {
      "type": "object",
      "description": "Konfigurasi Kubernetes Auth Backend di Secreton (zero-trust).",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "audience": {
          "type": "string"
        },
        "tokenTTL": {
          "type": "integer",
          "minimum": 600,
          "maximum": 86400
        },
        "policies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "authenc": {
      "$ref": "#/definitions/workload"
    },
    "secreton": {
      "$ref": "#/definitions/workload"
    },
    "layananIntegrasi": {
      "allOf": [
        {
          "$ref": "#/definitions/workload"
        },
        {
          "type": "object",
          "properties": {
            "cronjobs": {
              "type": "object",
              "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                  "$ref": "#/definitions/cronjob"
                }
              }
            },
            "cronjobDefaults": {
              "type": "object"
            }
          }
        }
      ]
    },
    "layananPerlengkapan": {
      "$ref": "#/definitions/workload"
    },
    "simpelv1": {
      "$ref": "#/definitions/workload"
    },
    "portal": {
      "$ref": "#/definitions/workload"
    },
    "perlengkapan": {
      "$ref": "#/definitions/workload"
    },
    "app-2026": {
      "$ref": "#/definitions/workload"
    },
    "postgres": {
      "$ref": "#/definitions/workload"
    },
    "redis": {
      "$ref": "#/definitions/workload"
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "Deployment",
            "StatefulSet"
          ]
        },
        "image": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "description": "Kosong = fallback ke global.imageTag. Untuk image first-party (dipilih lewat `name`) WAJIB semver `vX.Y.Z[-suffix]`; ditegakkan oleh aturan if/then di bawah, bukan sekadar dianjurkan di sini. Image upstream (dipilih lewat `repository`) memakai tag vendornya sendiri (mis. `16-alpine`)."
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent"
              ],
              "description": "`Never` sengaja TIDAK diizinkan: dikombinasikan dengan tag yang bisa bergerak ia membuat pod tak bisa dipulihkan begitu image-nya hilang dari disk node — persis kondisi namespace simpelv2-production hari ini."
            }
          },
          "if": {
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "tag": {
                "pattern": "^$|^v\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?$"
              }
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "$ref": "#/definitions/resourceList"
            },
            "limits": {
              "$ref": "#/definitions/resourceList"
            }
          }
        },
        "podSecurityContext": {
          "type": "object"
        },
        "containerSecurityContext": {
          "type": "object"
        },
        "probes": {
          "type": "object",
          "properties": {
            "startup": {
              "$ref": "#/definitions/probe"
            },
            "liveness": {
              "$ref": "#/definitions/probe"
            },
            "readiness": {
              "$ref": "#/definitions/probe"
            }
          }
        },
        "topologySpreadConstraints": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxSkew": {
              "type": "integer",
              "minimum": 1
            },
            "topologyKey": {
              "type": "string"
            },
            "whenUnsatisfiable": {
              "type": "string",
              "enum": [
                "DoNotSchedule",
                "ScheduleAnyway"
              ]
            }
          }
        },
        "podAntiAffinity": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "preferred",
                "required"
              ]
            }
          }
        },
        "hpa": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "cpuUtilization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "memoryUtilization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "pdb": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+%?$"
                }
              ]
            },
            "maxUnavailable": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+%?$"
                }
              ]
            }
          }
        },
        "istioInjection": {
          "type": "boolean"
        },
        "secretonAuth": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "role": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "tokenTTL": {
              "type": "integer",
              "minimum": 600
            },
            "tokenPath": {
              "type": "string"
            }
          }
        }
      }
    },
    "resourceList": {
      "type": "object",
      "properties": {
        "cpu": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d+m?$"
            },
            {
              "type": "number"
            }
          ]
        },
        "memory": {
          "type": "string",
          "pattern": "^\\d+(Mi|Gi|Ki|M|G|K)?$"
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "http",
            "grpc",
            "tcp",
            "exec"
          ]
        },
        "path": {
          "type": "string"
        },
        "port": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "scheme": {
          "type": "string",
          "enum": [
            "HTTP",
            "HTTPS"
          ]
        },
        "service": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "successThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cronjob": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "description": "Cron expression (5 atau 6 field). Validasi semantik dilakukan oleh kube-controller-manager saat apply."
        },
        "timeZone": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
