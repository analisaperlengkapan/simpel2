# SIMPEL Enhanced Build Configuration

# Parallel build settings
PARALLEL_JOBS=auto
ENABLE_INCREMENTAL=true
BUILD_CACHE_ENABLED=true

# Development server settings - Port allocation strategy
BASE_PORT=8080              # Main development server
FRONTEND_PORT_START=8081    # Microfrontends start from 8081
BACKEND_PORT_START=3000     # Backend services start from 3000
WATCH_FILES=true
ENABLE_PROXY=true
BACKEND_URL=http://localhost:3000

# Port allocation map:
# 8080 - Main dev server
# 8081-8100 - Microfrontends (antarmuka/*)
# 3000-3020 - Backend services (layanan/*)

# Performance monitoring
METRICS_RETENTION_DAYS=30
BASELINE_AUTO_UPDATE=false

# Optimization settings
AUTO_OPTIMIZE_DEPENDENCIES=false
CACHE_CLEANUP_INTERVAL=7
