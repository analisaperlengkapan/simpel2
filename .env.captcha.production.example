# CAPTCHA System Production Environment Variables
# Copy this file to .env.captcha and fill in the actual values

# Database Configuration
CAPTCHA_DB_HOST=captcha-analytics-db
CAPTCHA_DB_PORT=5432
CAPTCHA_DB_NAME=captcha_analytics
CAPTCHA_DB_USER=captcha_user
CAPTCHA_DB_PASSWORD=your_secure_database_password_here

# Redis Configuration
CAPTCHA_REDIS_HOST=captcha-redis
CAPTCHA_REDIS_PORT=6379
CAPTCHA_REDIS_PASSWORD=your_secure_redis_password_here

# Authenc Integration
AUTHENC_API_URL=https://auth.kejaksaan.go.id
AUTHENC_REALM=simpel
AUTHENC_CLIENT_ID=portal
AUTHENC_CLIENT_SECRET=your_authenc_client_secret_here

# Secreton Integration
SECRETON_API_URL=https://vault.kejaksaan.go.id
SECRETON_TOKEN=your_secreton_token_here
SECRETON_MOUNT_PATH=captcha
SECRETON_NAMESPACE=simpelv2

# Monitoring Configuration
PROMETHEUS_URL=http://captcha-prometheus:9090
GRAFANA_URL=http://captcha-grafana:3000
GRAFANA_API_KEY=your_grafana_api_key_here
CAPTCHA_GRAFANA_PASSWORD=your_secure_grafana_password_here

# Elasticsearch Configuration
ELASTICSEARCH_ENDPOINT=http://captcha-elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password_here

# OTLP Tracing
OTLP_ENDPOINT=http://jaeger:14268/api/traces
JAEGER_AGENT_ENDPOINT=jaeger:6831
JAEGER_COLLECTOR_ENDPOINT=http://jaeger:14268/api/traces

# Email Alerting
SMTP_HOST=smtp.kejaksaan.go.id
SMTP_PORT=587
SMTP_USERNAME=alerts@kejaksaan.go.id
SMTP_PASSWORD=your_smtp_password_here

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Webhook Alerting
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
BACKUP_NOTIFICATION_WEBHOOK=https://your-webhook-endpoint.com/backup

# PagerDuty Integration (optional)
PAGERDUTY_WEBHOOK_URL=https://events.pagerduty.com/integration/YOUR_INTEGRATION_KEY/enqueue

# Security Configuration
CAPTCHA_ENCRYPTION_KEY=your_32_character_encryption_key_here
CAPTCHA_SIGNING_KEY=your_signing_key_here
CAPTCHA_JWT_SECRET=your_jwt_secret_here

# Performance Configuration
CAPTCHA_MAX_CONCURRENT_CHALLENGES=1000
CAPTCHA_CACHE_TTL=3600
CAPTCHA_REQUEST_TIMEOUT=5000

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=simpelv2-captcha-backups
BACKUP_S3_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Feature Flags
CAPTCHA_BEHAVIORAL_ANALYSIS_ENABLED=true
CAPTCHA_ACCESSIBILITY_ENABLED=true
CAPTCHA_ADVANCED_ANALYTICS_ENABLED=true
CAPTCHA_REAL_TIME_MONITORING_ENABLED=true

# Rate Limiting
CAPTCHA_RATE_LIMIT_REQUESTS_PER_MINUTE=60
CAPTCHA_RATE_LIMIT_BURST=10
CAPTCHA_RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout,file,elasticsearch

# Development/Debug (set to false in production)
CAPTCHA_DEBUG_MODE=false
CAPTCHA_MOCK_MODE=false
CAPTCHA_TEST_MODE=false
