# Docker Compose environment variables for local development.
# Copy this file to `.env` (which is gitignored) and set real values.
#
# DO NOT commit `.env` or any file containing real credentials.

# PostgreSQL credentials used by all services in docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Laravel APP_KEY for the simpelv1 (Laravel) service. Required — without
# this, EncryptCookies throws "No application encryption key has been
# specified" on every request. Generate with:
#   docker compose run --rm simpelv1 php artisan key:generate --show
# or, if you have PHP locally:
#   cd monolith/simpelv1 && php artisan key:generate --show
SIMPELV1_APP_KEY=base64:CHANGEME
