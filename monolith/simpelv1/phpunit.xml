<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <!-- F5-A (#31): the only tests kept are simpelv1 ↔ Rust-service
             integration contract tests (authenc/secreton/… via Http::fake).
             All legacy/AI/example tests were removed (user decision). Add
             back Unit/Feature suites here if non-integration tests return. -->
        <testsuite name="Integration">
            <directory suffix="Test.php">./tests/Feature/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <!-- File-based supaya migrate-once + phpunit bisa pakai DB
             yang sama. `:memory:` ada per-connection sehingga test
             yang TIDAK pakai RefreshDatabase trait kehilangan schema.
             File dihapus di prepare-test-environment CI step. -->
        <env name="DB_DATABASE" value="/tmp/simpelv1-test.sqlite"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="APP_KEY" value="base64:3fS8oGvIu6zKkXp8N7U5fT9V3W2Y4Z6a7b8c9d0e1f2="/>
    </php>
</phpunit>
