# EditorConfig untuk SIMPelv2 - Government BMN Management System
# Rust/Leptos Microservices & Microfrontends Architecture
# https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

# Rust files - Government service standards
[*.{rs,toml}]
indent_size = 4
max_line_length = 100

# Leptos/WASM specific - Microfrontend standards
[*.rs]
max_line_length = 100

# Trunk config - Development server
[Trunk.toml]
indent_size = 2

# Docker & Infrastructure - Deployment configs
[{Dockerfile,*.dockerfile}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

# Documentation - Government documentation standards
[*.{md,txt}]
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
indent_style = tab

# Frontend Styling - Government design system
[*.{css,scss,sass}]
indent_size = 2
max_line_length = 120

# JavaScript/TypeScript (if any) - Legacy support
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Configuration files
[*.json]
indent_size = 2

[*.{env,env.*}]
indent_size = 2

# Shell scripts - DevOps automation
[*.{sh,bash}]
indent_size = 2
max_line_length = 120
