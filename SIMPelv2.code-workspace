{
    // ==========================================
    // SIMPelv2 - Multi-Module Workspace Configuration
    // ==========================================
    // Description: Complete development environment for SIMPelv2 project
    // Version: 3.0 - Optimized for Cargo Workspace
    // Last Updated: January 2026
    // ==========================================
    "folders": [
        {
            "name": "🏠 SIMPelv2 Root",
            "path": "."
        },
        {
            "name": "📚 Shared Libraries (Lib)",
            "path": "./lib"
        },
        {
            "name": "🖥️ Frontend Microfrontends",
            "path": "./antarmuka"
        },
        {
            "name": "⚙️ Backend Services",
            "path": "./layanan"
        },
        {
            "name": "🐳 Infrastructure",
            "path": "./infra"
        },
        {
            "name": "📜 Scripts",
            "path": "./scripts"
        },
        {
            "name": "📖 Documentation",
            "path": "./docs"
        }
    ],
    "settings": {
        // ========================================
        // WORKSPACE-WIDE PERFORMANCE SETTINGS
        // ========================================
        "files.watcherExclude": {
            "**/target/**": true,
            "**/node_modules/**": true,
            "**/.git/objects/**": true,
            "**/.git/subtree-cache/**": true,
            "**/dist/**": true,
            "**/pkg/**": true,
            "**/.vscode-server/**": true,
            "**/.cache/**": true
        },
        "search.exclude": {
            "**/target/**": true,
            "**/node_modules/**": true,
            "**/dist/**": true,
            "**/pkg/**": true,
            "**/.git/**": true,
            "**/.*cache*/**": true
        },
        // ========================================
        // RUST ANALYZER WORKSPACE SETTINGS
        // ========================================
        "rust-analyzer.linkedProjects": [
            "./Cargo.toml",
            "./infra/authenc/Cargo.toml",
            "./infra/secreton/Cargo.toml"
        ],
        "rust-analyzer.cargo.buildScripts.enable": true,
        "rust-analyzer.procMacro.enable": true,
        "rust-analyzer.checkOnSave.command": "check",
        // ========================================
        // EDITOR WORKSPACE BEHAVIOR
        // ========================================
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.eslint": "explicit",
            "source.organizeImports": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        // ========================================
        // LANGUAGE-SPECIFIC WORKSPACE SETTINGS
        // ========================================
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true,
            "editor.semanticHighlighting.enabled": true
        },
        "[toml]": {
            "editor.defaultFormatter": "tamasfe.even-better-toml"
        },
        "[json]": {
            "editor.defaultFormatter": "vscode.json-language-features"
        }
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "🔍 Check Workspace",
                "type": "shell",
                "command": "cargo check --workspace",
                "group": "build",
                "problemMatcher": [
                    "$rustc"
                ]
            },
            {
                "label": "🧪 Test Workspace",
                "type": "shell",
                "command": "cargo test --workspace",
                "group": "test",
                "problemMatcher": [
                    "$rustc"
                ]
            },
            {
                "label": "🧹 Format Workspace",
                "type": "shell",
                "command": "cargo fmt --all",
                "group": "none"
            },
            {
                "label": "🔒 Audit Dependencies",
                "type": "shell",
                "command": "cargo audit",
                "group": "none"
            },
            {
                "label": "🚀 Run Portal",
                "type": "shell",
                "command": "cd antarmuka/portal && trunk serve",
                "group": "test"
            }
        ]
    },
    "extensions": {
        "recommendations": [
            "rust-lang.rust-analyzer",
            "vadimcn.vscode-lldb",
            "ms-azuretools.vscode-docker",
            "tamasfe.even-better-toml",
            "serayuzgur.crates",
            "dustypomerleau.rust-syntax"
        ]
    }
}
